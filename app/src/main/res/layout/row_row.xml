<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/soft_plain" android:orientation="horizontal">
    <ImageView android:id="@+id/rr_acc" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/rr_l" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/ink" android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/rr_r" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/ink" android:textSize="13.5sp" android:textStyle="bold" android:maxLines="1" />
      </LinearLayout>
      <TextView android:id="@+id/rr_s" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
