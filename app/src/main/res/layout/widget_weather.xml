<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_weather" android:orientation="vertical" android:padding="13dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_weather" /><TextView android:id="@+id/title_text" style="@style/WTitle" android:textColor="@color/weather" android:text="WEATHER" /><TextView android:id="@+id/updated_text" style="@style/WSub" /><ImageView android:id="@+id/refresh" android:layout_width="30dp" android:layout_height="24dp" android:paddingStart="8dp" android:src="@drawable/ic_refresh" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="44sp" />
  <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/ink" android:textSize="48sp" android:textStyle="bold" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
    <TextView android:id="@+id/w_cond" style="@style/WLine" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_feels" style="@style/WLine" android:textColor="@color/muted" android:textSize="11.5sp" />
    <TextView android:id="@+id/w_hilo" style="@style/WLine" android:textColor="@color/muted" android:textSize="11.5sp" />
  </LinearLayout>
</LinearLayout>
<TextView android:id="@+id/w_place" style="@style/WLine" android:layout_marginTop="2dp" android:textColor="@color/weather" android:textSize="11.5sp" android:textStyle="bold" />
<TextView android:id="@+id/w_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/soft_plain" android:padding="10dp" android:textColor="@color/ink" android:textSize="12.5sp" android:visibility="gone" /><TextView android:id="@+id/w_hours_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.07" android:text="NEXT HOURS" />
<LinearLayout android:id="@+id/w_hours" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/soft_plain" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" />
<TextView android:id="@+id/w_days_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.07" android:text="NEXT DAYS" />
<LinearLayout android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical" />
</LinearLayout>
