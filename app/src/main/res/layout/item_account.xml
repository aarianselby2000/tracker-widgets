<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/acct_card" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/item_bg" android:orientation="vertical" android:padding="11dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/acct_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/acct_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/soft_plain" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
  </LinearLayout>
  <TextView android:id="@+id/acct_bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
  <TextView android:id="@+id/acct_note" style="@style/WLine" android:textColor="@color/muted" android:textSize="11sp" android:maxLines="2" />
  <FrameLayout android:id="@+id/acct_bars" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="5dp">
    <ProgressBar android:id="@+id/acct_bar_g" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#55B981" />
    <ProgressBar android:id="@+id/acct_bar_a" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#F0A040" android:visibility="gone" />
    <ProgressBar android:id="@+id/acct_bar_r" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#F07070" android:visibility="gone" />
    <ProgressBar android:id="@+id/acct_bar_b" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#6B9CEC" android:visibility="gone" />
  </FrameLayout>
  <TextView android:id="@+id/acct_recent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="11sp" android:lineSpacingExtra="2dp" android:ellipsize="end" />
  <TextView android:id="@+id/acct_asof" style="@style/WLine" android:textColor="#6B7380" android:textSize="10sp" />
</LinearLayout>
