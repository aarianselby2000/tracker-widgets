<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="4dp">
  <ImageView android:id="@+id/ev_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <ImageView android:id="@+id/ev_bar" android:layout_width="4dp" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="5dp" android:paddingTop="4dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/ev_time" style="@style/WLine" android:textColor="@color/muted" android:textSize="10sp" />
      <TextView android:id="@+id/ev_title" style="@style/WLine" android:textStyle="bold" android:maxLines="2" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
