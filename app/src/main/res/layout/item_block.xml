<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/blk" android:layout_width="10dp" android:layout_height="10dp">
  <ImageView android:id="@+id/blk_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/block" android:scaleType="fitXY" />
  <ImageView android:id="@+id/blk_bar" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="3dp" android:paddingTop="2dp">
    <TextView android:id="@+id/blk_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="10.5sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/blk_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="@color/muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
</FrameLayout>
