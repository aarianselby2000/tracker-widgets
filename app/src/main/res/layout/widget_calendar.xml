<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_calendar" android:orientation="vertical" android:padding="13dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_calendar" /><TextView android:id="@+id/title_text" style="@style/WTitle" android:textColor="@color/calendar" android:text="CALENDAR" /><TextView android:id="@+id/updated_text" style="@style/WSub" /><TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/soft_plain" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold" android:text="⟳ Sync" /></LinearLayout>
