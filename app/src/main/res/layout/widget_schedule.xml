<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_schedule" android:orientation="vertical" android:padding="13dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_schedule" /><TextView android:id="@+id/title_text" style="@style/WTitle" android:textColor="@color/schedule" android:text="SCHEDULE" /><TextView android:id="@+id/updated_text" style="@style/WSub" /><ImageView android:id="@+id/refresh" android:layout_width="30dp" android:layout_height="24dp" android:paddingStart="8dp" android:src="@drawable/ic_refresh" /></LinearLayout><LinearLayout android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
