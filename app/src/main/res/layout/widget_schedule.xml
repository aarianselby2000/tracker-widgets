<LinearLayout android:id="@+id/names" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingStart="30dp" android:orientation="horizontal" android:visibility="gone"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:textColor="@color/aarian" android:textSize="12sp" android:textStyle="bold" android:text="AARIAN" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:textColor="@color/miranda" android:textSize="12sp" android:textStyle="bold" android:text="MIRANDA ❤" /></LinearLayout>
<FrameLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" />
<TextView android:id="@+id/study_text" style="@style/WLine" android:layout_marginTop="4dp" android:textColor="#3EC2AC" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
