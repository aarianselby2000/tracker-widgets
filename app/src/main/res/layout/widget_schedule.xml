  </LinearLayout><ImageView android:layout_width="6dp" android:layout_height="1dp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/soft_miranda" android:orientation="vertical" android:padding="7dp">
    <TextView android:id="@+id/name_mi" style="@style/WLine" android:fontFamily="sans-serif-condensed" android:textColor="@color/miranda" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.05" android:text="MIRANDA ❤" />
    <TextView android:id="@+id/now_mi" style="@style/WLine" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
    <TextView android:id="@+id/next_mi" style="@style/WLine" android:textColor="@color/muted" android:textSize="10sp" android:maxLines="2" />
