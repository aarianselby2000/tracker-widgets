<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sync_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/dialog_bg" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.06" android:text="⟳ SYNC" />
      <TextView android:id="@+id/sync_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="@color/ink" android:textSize="13sp" />
      <TextView android:id="@+id/sync_close" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/muted" android:textSize="16sp" android:text="✕" android:contentDescription="Close" />
    </LinearLayout>
    <TextView android:id="@+id/sync_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/btn_primary" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/on_primary" android:textStyle="bold" android:visibility="gone" />
    <FrameLayout android:id="@+id/sync_web" android:layout_width="match_parent" android:layout_height="2dp" />
  </LinearLayout>
</LinearLayout>
