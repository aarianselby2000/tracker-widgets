<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wbg_steps" android:orientation="vertical" android:padding="13dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_steps" /><TextView android:id="@+id/title_text" style="@style/WTitle" android:textColor="@color/steps" android:text="STEPS" /><TextView android:id="@+id/updated_text" style="@style/WSub" /><ImageView android:id="@+id/refresh" android:layout_width="30dp" android:layout_height="24dp" android:paddingStart="8dp" android:src="@drawable/ic_refresh" /></LinearLayout>
<TextView android:id="@+id/sp_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/ink" android:textSize="44sp" android:textStyle="bold" android:text="–" />
<TextView android:id="@+id/sp_sub" style="@style/WLine" android:textColor="@color/muted" android:textSize="12sp" />
<FrameLayout android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp">
  <ProgressBar android:id="@+id/sp_bar_g" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#74C35E" android:visibility="gone" />
  <ProgressBar android:id="@+id/sp_bar_b" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:max="100" android:progressBackgroundTint="#FF2A313B" android:progressTint="#6B9CEC" />
</FrameLayout>
<TextView android:id="@+id/sp_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/soft_plain" android:padding="10dp" android:textColor="@color/ink" android:textSize="12.5sp" android:visibility="gone" /><TextView android:id="@+id/sp_days_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.07" android:text="LAST 7 DAYS" />
<LinearLayout android:id="@+id/sp_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical" />
</LinearLayout>
