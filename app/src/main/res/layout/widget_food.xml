</LinearLayout>
<TextView android:id="@+id/btn_food" style="@style/WBtn" android:layout_width="match_parent" android:layout_weight="0" android:layout_marginTop="5dp" android:background="@drawable/btn_primary" android:textColor="@color/on_primary" android:text="＋ Add food" />
