<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TODAY" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="2dp" android:text="↻" android:textColor="@color/muted" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/kcal_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="12sp" android:maxLines="1" />
    <ProgressBar android:id="@+id/kcal_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressTint="#F0A040" android:progressBackgroundTint="#33FFFFFF" />
    <TextView android:id="@+id/protein_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="12sp" android:maxLines="1" />
    <ProgressBar android:id="@+id/protein_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressTint="#6B9CEC" android:progressBackgroundTint="#33FFFFFF" />
    <TextView android:id="@+id/water_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="12sp" android:maxLines="1" />
    <ProgressBar android:id="@+id/water_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressTint="#5BB3F0" android:progressBackgroundTint="#33FFFFFF" />
    <TextView android:id="@+id/extra_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="11sp" android:maxLines="2" />
    <TextView android:id="@+id/updated_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
