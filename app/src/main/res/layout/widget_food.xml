<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/title_text" style="@style/WTitle" android:text="HEALTH" /><TextView android:id="@+id/updated_text" style="@style/WSub" /><TextView android:id="@+id/refresh" style="@style/WRefresh" /></LinearLayout>
<TextView android:id="@+id/kcal_text" style="@style/WLine" android:layout_marginTop="6dp" />
<ProgressBar android:id="@+id/kcal_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressBackgroundTint="#33FFFFFF" android:progressTint="#F0A040" />
<TextView android:id="@+id/protein_text" style="@style/WLine" android:layout_marginTop="5dp" />
<ProgressBar android:id="@+id/protein_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressBackgroundTint="#33FFFFFF" android:progressTint="#6B9CEC" />
<TextView android:id="@+id/water_text" style="@style/WLine" android:layout_marginTop="5dp" />
<ProgressBar android:id="@+id/water_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progressBackgroundTint="#33FFFFFF" android:progressTint="#5BB3F0" />
<TextView android:id="@+id/extra_text" style="@style/WLine" android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="11sp" />
<TextView android:id="@+id/foods_text" style="@style/WLine" android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="11sp" android:maxLines="2" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
