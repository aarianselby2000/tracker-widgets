<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="7dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginTop="4dp"><ImageView android:id="@+id/chip_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" /><TextView android:id="@+id/chip_t" style="@style/PillText" /></FrameLayout>
    <TextView android:id="@+id/name_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="3dp" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>
  <TextView android:id="@+id/cls_text" style="@style/WLine" android:textColor="@color/muted" android:textSize="11sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <FrameLayout android:id="@+id/s0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginTop="4dp"><ImageView android:id="@+id/s0_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" /><TextView android:id="@+id/s0_t" style="@style/PillText" /></FrameLayout><FrameLayout android:id="@+id/s1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginTop="4dp"><ImageView android:id="@+id/s1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" /><TextView android:id="@+id/s1_t" style="@style/PillText" /></FrameLayout><FrameLayout android:id="@+id/s2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginTop="4dp"><ImageView android:id="@+id/s2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" /><TextView android:id="@+id/s2_t" style="@style/PillText" /></FrameLayout><FrameLayout android:id="@+id/s3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginTop="4dp"><ImageView android:id="@+id/s3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pill" android:scaleType="fitXY" /><TextView android:id="@+id/s3_t" style="@style/PillText" /></FrameLayout>
  </LinearLayout>
  <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@color/line" android:scaleType="fitXY" />
</LinearLayout>
