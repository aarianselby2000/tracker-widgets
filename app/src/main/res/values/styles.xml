<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/ink</item><item name="android:textSize">13sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item></style>
    <style name="WSub"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:paddingStart">8dp</item><item name="android:textColor">@color/muted</item><item name="android:textSize">10sp</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item></style>
    <style name="WRefresh"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:paddingStart">10dp</item><item name="android:paddingEnd">2dp</item><item name="android:text">↻</item><item name="android:textColor">@color/muted</item><item name="android:textSize">17sp</item></style>
    <style name="WLine"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/ink</item><item name="android:textSize">12sp</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item></style>
    <style name="WBar"><item name="android:layout_width">match_parent</item><item name="android:layout_height">6dp</item><item name="android:layout_marginTop">2dp</item><item name="android:max">100</item><item name="android:progressBackgroundTint">#33FFFFFF</item></style>
    <style name="WBtn"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:background">@drawable/btn_bg</item><item name="android:gravity">center</item><item name="android:paddingTop">7dp</item><item name="android:paddingBottom">7dp</item><item name="android:textColor">@color/ink</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item><item name="android:maxLines">1</item></style>
    <style name="PillText"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item><item name="android:paddingTop">3dp</item><item name="android:paddingBottom">3dp</item><item name="android:textSize">11sp</item><item name="android:maxLines">1</item></style>
</resources>
