<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">6dp</item><item name="android:fontFamily">sans-serif-condensed</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item></style>
    <style name="WSub"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:paddingStart">8dp</item><item name="android:textColor">@color/muted</item><item name="android:textSize">10sp</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item></style>
    <style name="WLine"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/ink</item><item name="android:textSize">12sp</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item></style>
    <style name="WBtn"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:background">@drawable/btn_bg</item><item name="android:gravity">center</item><item name="android:paddingTop">11dp</item><item name="android:paddingBottom">11dp</item><item name="android:textColor">@color/ink</item><item name="android:textSize">13.5sp</item><item name="android:textStyle">bold</item><item name="android:maxLines">1</item></style>
    <style name="PillText"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item><item name="android:paddingTop">7dp</item><item name="android:paddingBottom">7dp</item><item name="android:textSize">12.5sp</item><item name="android:textStyle">bold</item><item name="android:maxLines">1</item></style>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/school</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="EntryTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/health</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>
